  "rendering_rules": {
    "background": {
      "use_original_image": true,
      "preserve_aspect_ratio": false,
      "position": "0,0",
      "width": 1094,
      "height": 644,
      "note": "Page is 85 x 55 mm; artwork and coordinates are scaled per-axis onto it, so both stretch identically and stay aligned."
    },
    "dynamic_text": {
      "render_after_background": true,
      "labels_already_exist_in_background": true,
      "do_not_render_colons": true,
      "do_not_render_labels": true
    },
    "photo": {
      "render_after_background": true,
      "do_not_render_photo_border": true,
      "clip_to_existing_frame": true
    },
    "qr": {
      "render_after_background": true,
      "do_not_render_qr_border": true
    },
    "layer_order": ["background", "dynamic_text", "member_photo", "qr_code"],
    "rules": [
      "Do not change the final client-approved artwork, layout, dimensions, typography, colors, logo, icons, borders, or static text.",
      "Do not add Member ID because it is not present as a field on this final template.",
      "Do not make any back-side field dynamic.",
      "Photo must be cropped to the photo rectangle without stretching.",
      "QR must be generated dynamically from member.verification_url and must fit entirely inside the front QR placeholder.",
      "Valid Upto must be generated as exactly one calendar year after issue_date, not 365 days.",
      "Keep the existing signature untouched.",
      "Use the JSON rectangles as the single source of truth for dynamic placement.",
      "Do not scatter hardcoded coordinates throughout the codebase.",
      "Before export, validate that text does not overflow its assigned rectangle."
    ]
  }
